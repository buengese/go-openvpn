# System defaults for the source-built OpenSSL 1.1.1, copied from bullseye's
# /etc/ssl/openssl.cnf so that 2.4 and 2.5 negotiate as they did there.
openssl_conf = default_conf

[default_conf]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.2
CipherString = DEFAULT@SECLEVEL=2
