# Pinned inputs for the OpenVPN server matrix images.
#
# This file is the single source of truth for the pins. `build.sh` sources it;
# `testenv/matrix_pins.go` mirrors it in Go constants and `TestPinsMatchVersionsEnv`
# (a plain unit test, no Docker) fails if the two ever drift.
#
# Nothing here may be a floating tag. Base images are pinned by manifest digest
# and every OpenVPN tarball is verified against a recorded SHA-256 during the
# image build. The SHA-256 values below were taken from tarballs downloaded from
# https://build.openvpn.net/downloads/releases/ and cross-checked against the
# detached OpenPGP signatures published alongside them, which are signed by
# "OpenVPN - Security Mailing List <security@openvpn.net>"
# (F554A3687412CFFEBDEFE0A312F5F7B42F2B01E7).

# Local-only image repository. These images are built by `make matrix-images`
# and are never pushed anywhere.
MATRIX_IMAGE_REPO="openlawsvpn-test/openvpn-server"

MATRIX_SOURCE_URL_BASE="https://build.openvpn.net/downloads/releases"

# --- 2.4 -------------------------------------------------------------------
# The important one: 2.4 predates TLS keying-material-exporter support, so it
# forces the classic OpenVPN PRF path. OpenSSL 3.x will not build 2.4, hence
# bullseye (OpenSSL 1.1.1).
OPENVPN_24_VERSION="2.4.12"
OPENVPN_24_SHA256="66952d9c95490e5875f04c9f8fa313b5e816d1b7b4d6cda3fb2ff749ad405dee"
OPENVPN_24_BASE="debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd"
OPENVPN_24_CONFIGURE="--prefix=/usr --enable-iproute2 --enable-lzo --enable-lz4 --disable-plugin-auth-pam"

# --- 2.5 -------------------------------------------------------------------
OPENVPN_25_VERSION="2.5.11"
OPENVPN_25_SHA256="7e2672119bd4639819d560f332a8b9b7e28f562425c77899f36d419fe4265f56"
OPENVPN_25_BASE="debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd"
OPENVPN_25_CONFIGURE="--prefix=/usr --enable-iproute2 --enable-lzo --enable-lz4 --disable-plugin-auth-pam"

# --- 2.6 -------------------------------------------------------------------
# 2.6 requires OpenSSL 3.x, hence bookworm. It talks netlink directly, so there
# is no --enable-iproute2; DCO is disabled because it needs a host kernel module.
OPENVPN_26_VERSION="2.6.22"
OPENVPN_26_SHA256="f46df740f05f86020137a41cfc8814352391cf861ed57f57b4e815cb97c1d2cf"
OPENVPN_26_BASE="debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171"
OPENVPN_26_CONFIGURE="--prefix=/usr --enable-lzo --enable-lz4 --disable-dco --disable-plugin-auth-pam"
