+/*
+ * go-openlawsvpn control-channel wrap instrumentation.
+ *
+ * Prints one greppable line:  TLSWRAPDEBUG <tag> <hex> [<trailer>]
+ *
+ * The trailer carries free-form text that may contain spaces (init_key_ctx()'s
+ * log prefix does), so it goes last and the hex stays a single field.
+ *
+ * This deliberately does NOT go through msg().  msg() formats into a buffer of
+ * ERR_BUF_SIZE (1280 without PKCS#11) and then formats *again* to prepend the
+ * per-instance prefix, so a line is silently clipped somewhere past 1200
+ * characters -- and where exactly depends on how long the tag and the peer's
+ * address are.  That truncates precisely the vectors worth having, the full
+ * P_CONTROL_V1 packets, and it truncates two stages of the same packet at two
+ * different points, which reads as a wire-format discovery rather than as a
+ * logging limit.  It cost an hour once; it will not cost a second.
+ *
+ * Control packets are bounded by --tls-mtu (1250 by default) plus the wrap
+ * overhead, so TLSWRAPDEBUG_MAX is comfortably above anything either caller can
+ * hand us.  A longer buffer is reported rather than truncated: a silently
+ * truncated vector is worse than a missing one, because it still looks like a
+ * vector.
+ *
+ * This exists only in the throwaway "tlswrapdebug" image.  It prints the
+ * control-channel key material and every control packet in the clear, and must
+ * never be built into anything that carries real traffic.
+ * See docker/TLS-WRAP-VECTORS.md.
+ */
+#define TLSWRAPDEBUG_MAX 2048
+
+void
+tlswrapdebug_dump(const char *tag, const uint8_t *data, int len,
+                  const char *trailer)
+{
+    char hex[2 * TLSWRAPDEBUG_MAX + 1];
+    int i;
+
+    if (len < 0 || len > TLSWRAPDEBUG_MAX)
+    {
+        fprintf(stderr, "TLSWRAPDEBUG %s <oversized:%d>\n", tag, len);
+        fflush(stderr);
+        return;
+    }
+    for (i = 0; i < len; ++i)
+    {
+        openvpn_snprintf(&hex[i * 2], 3, "%02x", data[i]);
+    }
+    hex[len * 2] = '\0';
+    fprintf(stderr, "TLSWRAPDEBUG %s %s%s%s\n", tag, hex,
+            trailer ? " " : "", trailer ? trailer : "");
+    fflush(stderr);
+}
